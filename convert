#!/usr/bin/env bash
set -euo pipefail

# 始终以脚本所在目录为工作目录，保证 assets/、styles/、config/ 路径稳定。
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
cd "$SCRIPT_DIR"

THEME="light"
OUT_DIR="dist"
SRC_DIR="src"   # 默认发现 src/ 下的 *.md
NO_SANDBOX=0
RELATIVE_LINKS=1
MD_FILES=()

usage() {
  cat <<'EOF'
Usage: ./convert [options] [file.md ...]

Options:
  -t, --theme <light|dark|both>  Theme, default light
  -o, --out <dir>                Output folder, default dist
  -s, --src <dir>                Source folder (discovers *.md), default src
      --no-sandbox               Launch Chrome with --no-sandbox (containers/CI)
      --no-relative-links        Keep absolute file:// links instead of relative
  -h, --help                     Show help

Output naming:
  light / dark : <out>/<filename>.pdf
  both         : <out>/<filename>.light.pdf
                 <out>/<filename>.dark.pdf

Links:
  Relative .md links are rewritten to relative links pointing at the generated
  PDFs in the same output folder, so the folder can be moved as a whole. Local
  links without a matching file become plain text; external http(s) links are
  kept unchanged.

Examples:
  ./convert
  ./convert --theme both
  ./convert --src notes --out build
  ./convert --theme dark chapter-1.md chapter-7.md
EOF
}

die() {
  echo "Error: $*" >&2
  exit 1
}

# 参数解析
while (( $# > 0 )); do
  case "$1" in
    -t|--theme)
      if (( $# < 2 )); then
        die "option $1 requires an argument"
      fi
      THEME="$2"
      shift 2
      ;;
    --theme=*)
      THEME="${1#*=}"
      shift
      ;;
    -o|--out)
      if (( $# < 2 )); then
        die "option $1 requires an argument"
      fi
      OUT_DIR="$2"
      shift 2
      ;;
    --out=*)
      OUT_DIR="${1#*=}"
      shift
      ;;
    --no-sandbox)
      NO_SANDBOX=1
      shift
      ;;
    -s|--src)
      if (( $# < 2 )); then
        die "option $1 requires an argument"
      fi
      SRC_DIR="$2"
      shift 2
      ;;
    --src=*)
      SRC_DIR="${1#*=}"
      shift
      ;;
    --no-relative-links)
      RELATIVE_LINKS=0
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      while (( $# > 0 )); do
        MD_FILES+=("$1")
        shift
      done
      ;;
    -*)
      die "unknown option: $1 (see --help)"
      ;;
    *)
      MD_FILES+=("$1")
      shift
      ;;
  esac
done

case "$THEME" in
  light|dark|both) ;;
  *) die "theme must be light, dark or both, got: $THEME" ;;
esac

if [[ -z "$OUT_DIR" ]]; then
  die "output folder must not be empty"
fi

command -v md-to-pdf >/dev/null 2>&1 || \
  die "md-to-pdf is not installed. Install it with: npm i -g md-to-pdf"

if (( RELATIVE_LINKS )); then
  command -v node >/dev/null 2>&1 || die "node not found; it is required to rewrite relative links"
  [[ -f "$SCRIPT_DIR/tools/relativize-links.js" ]] || \
    die "missing tools/relativize-links.js"
  [[ -f "$SCRIPT_DIR/assets/pdf-lib/pdf-lib.min.js" ]] || \
    die "missing assets/pdf-lib/pdf-lib.min.js"
fi

CONFIG_FILE="$SCRIPT_DIR/config/md-to-pdf.config.js"
[[ -f "$CONFIG_FILE" ]] || die "config file not found: $CONFIG_FILE"
[[ -f "$SCRIPT_DIR/assets/katex/katex.min.js" ]] || \
  die "missing assets/katex/katex.min.js"
[[ -f "$SCRIPT_DIR/assets/katex/katex.min.css" ]] || \
  die "missing assets/katex/katex.min.css"
[[ -d "$SCRIPT_DIR/assets/katex/fonts" ]] || \
  die "missing assets/katex/fonts"

mkdir -p "$OUT_DIR"
OUT_ABS="$(cd "$OUT_DIR" && pwd)"
export MD2PDF_OUTPUT_DIR="$OUT_ABS"

# 解析源目录：相对路径以脚本所在目录为基准；空值退回仓库根目录。
if [[ -z "$SRC_DIR" ]]; then
  SRC_DIR="$SCRIPT_DIR"
else
  [[ "$SRC_DIR" = /* ]] || SRC_DIR="$SCRIPT_DIR/$SRC_DIR"
  [[ -d "$SRC_DIR" ]] || die "source folder not found: $SRC_DIR"
  SRC_DIR="$(cd "$SRC_DIR" && pwd)"
fi

# 没有显式文件参数时，转换源目录下的全部 .md
if (( ${#MD_FILES[@]} == 0 )); then
  shopt -s nullglob
  default_files=("$SRC_DIR"/*.md)
  shopt -u nullglob
  MD_FILES=("${default_files[@]}")
fi

if (( ${#MD_FILES[@]} == 0 )); then
  echo "no .md files found in source folder, nothing to convert: $SRC_DIR"
  exit 0
fi

for index in "${!MD_FILES[@]}"; do
  md_file="${MD_FILES[$index]}"

  # 显式参数先按当前目录解析，找不到再到源目录里找，方便直接写文件名。
  if [[ ! -f "$md_file" && -f "$SRC_DIR/$md_file" ]]; then
    md_file="$SRC_DIR/$md_file"
  fi

  [[ -f "$md_file" ]] || die "file not found: ${MD_FILES[$index]}"
  [[ "$md_file" == *.md ]] || die "not a .md file: $md_file"
  MD_FILES[$index]="$md_file"
done

# 同一批文件里出现同名 Markdown 会互相覆盖输出 PDF，提前报错。
declare -A seen_base=()
for md_file in "${MD_FILES[@]}"; do
  base="$(basename -- "$md_file" .md)"
  if [[ -n "${seen_base[$base]:-}" ]]; then
    die "duplicate file name: ${seen_base[$base]} and $md_file would both write $base.pdf"
  fi
  seen_base["$base"]="$md_file"
done

if [[ "$THEME" == "both" ]]; then
  themes=(light dark)
else
  themes=("$THEME")
fi

# 受限环境下把 Chrome 的配置/缓存放到临时目录，结束后清理。
CHROME_TMP=""
cleanup() {
  if [[ -n "$CHROME_TMP" && -d "$CHROME_TMP" ]]; then
    rm -rf -- "$CHROME_TMP" || true
  fi
}
trap cleanup EXIT

if (( NO_SANDBOX )); then
  CHROME_TMP="$(mktemp -d "${TMPDIR:-/tmp}/md2pdf-chrome.XXXXXX")"
  export MD2PDF_NO_SANDBOX=1
  export MD2PDF_CHROME_PROFILE="$CHROME_TMP/profile"
  export XDG_CONFIG_HOME="$CHROME_TMP/config"
  mkdir -p "$MD2PDF_CHROME_PROFILE" "$XDG_CONFIG_HOME"
fi

extract_title() {
  local file="$1"
  local title=""

  title="$(grep -m1 -E '^#[[:space:]]+' -- "$file" 2>/dev/null | \
    sed -E 's/^#[[:space:]]+//; s/[[:space:]]+$//')" || true

  if [[ -z "$title" ]]; then
    title="$(basename -- "$file" .md)"
  fi

  printf '%s' "$title"
}

total=0
failed=0
failed_items=()
link_failed=0
link_failed_items=()

for md_file in "${MD_FILES[@]}"; do
  base="$(basename -- "$md_file" .md)"
  title="$(extract_title "$md_file")"
  src_pdf="${md_file%.md}.pdf"
  export MD2PDF_SOURCE_DIR="$(cd -- "$(dirname -- "$md_file")" >/dev/null 2>&1 && pwd)"

  for theme_name in "${themes[@]}"; do
    if [[ "$THEME" == "both" ]]; then
      target="$OUT_ABS/${base}.${theme_name}.pdf"
      export MD2PDF_LINK_SUFFIX=".${theme_name}.pdf"
    else
      target="$OUT_ABS/${base}.pdf"
      export MD2PDF_LINK_SUFFIX=".pdf"
    fi

    total=$((total + 1))
    echo "==> [$theme_name] $md_file -> $target"

    # md-to-pdf 在源文件旁生成 PDF；先清掉上次的残留文件。
    rm -f -- "$src_pdf"

    if ! MD2PDF_THEME="$theme_name" md-to-pdf "$md_file" \
      --config-file "$CONFIG_FILE" \
      --basedir "$SCRIPT_DIR" \
      --document-title "$title"; then
      rm -f -- "$src_pdf"
      failed=$((failed + 1))
      failed_items+=("$md_file ($theme_name)")
      echo "    conversion failed" >&2
      continue
    fi

    if [[ ! -f "$src_pdf" ]]; then
      failed=$((failed + 1))
      failed_items+=("$md_file ($theme_name): no PDF generated")
      echo "    generated PDF not found: $src_pdf" >&2
      continue
    fi

    src_abs="$(realpath -m -- "$src_pdf")"
    if [[ "$src_abs" != "$target" ]]; then
      mv -f -- "$src_pdf" "$target"
    fi

    # 把 config 写出的 file:// 绝对链接改写成相对文件链接。
    if (( RELATIVE_LINKS )); then
      if ! node "$SCRIPT_DIR/tools/relativize-links.js" "$target"; then
        link_failed=$((link_failed + 1))
        link_failed_items+=("$target")
      fi
    fi

    echo "    done"
  done
done

echo
if (( link_failed > 0 )); then
  echo "Warning: failed to rewrite relative links in $link_failed PDF(s); links kept as absolute file:// URIs" >&2
  for item in "${link_failed_items[@]}"; do
    echo "  not rewritten: $item" >&2
  done
fi

if (( failed > 0 )); then
  echo "Completed: $((total - failed)) / $total PDF(s)"
  for item in "${failed_items[@]}"; do
    echo "  failed: $item"
  done
  exit 1
fi

echo "Done: $total PDF(s)"
echo "  source: $SRC_DIR"
echo "  output: $OUT_ABS"
